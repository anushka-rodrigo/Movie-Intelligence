# Raw data (too large for GitHub; download from Kaggle, see data/raw_data/README.md)
data/raw_data/*
!data/raw_data/README.md
!data/raw_data/.gitkeep

# Processed data (regenerated by the ETL pipeline)
data/processed/*
!data/processed/.gitkeep

# Any stray CSV / large data files
*.csv
*.parquet
*.pkl

# Secrets and environment
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Docker
docker-compose.override.yml